// Pixel art as a 2D shape, centred on the origin, each pixel `px` mm; row 0 is the top
module pixel_art(art, px) {
    h = len(art);
    w = len(art[0]);
    translate([-w * px / 2, -h * px / 2])
        for (y = [0:h - 1], x = [0:w - 1]) if (art[y][x] == "#")
            translate([x * px, (h - 1 - y) * px]) square(px + 0.001);
}
